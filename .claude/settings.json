{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/terraform.tfvars)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Read(~/.docker/config.json)",
      "Edit(./.env)",
      "Edit(**/*.tfstate)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.github/CODEOWNERS)",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(uv add:*)",
      "Bash(brew install:*)",
      "Bash(docker system prune:*)",
      "Bash(kind delete:*)"
    ],
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(make check:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform init -backend=false:*)",
      "Bash(terraform validate:*)",
      "Bash(tflint:*)",
      "Bash(checkov:*)",
      "Bash(trivy:*)",
      "Bash(hadolint:*)",
      "Bash(actionlint:*)",
      "Bash(gitleaks:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(kubeconform:*)",
      "Bash(docker build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
