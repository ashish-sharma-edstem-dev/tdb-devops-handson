variable "name" {
  description = "DB instance identifier and name prefix, e.g. tdb-bookings-prod."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,50}[a-z0-9]$", var.name)) && !strcontains(var.name, "--")
    error_message = "name must be a valid RDS identifier: lowercase letters, digits, single hyphens, start with a letter."
  }
}

variable "vpc_id" {
  description = "VPC the database lives in."
  type        = string
}

variable "db_subnet_ids" {
  description = "Private DB subnets (no internet route). At least two AZs; RDS requires it even for single-AZ."
  type        = list(string)

  validation {
    condition     = length(var.db_subnet_ids) >= 2
    error_message = "db_subnet_ids needs subnets in at least two availability zones."
  }
}

variable "allowed_security_groups" {
  description = "Security groups allowed to connect on 5432, keyed by a static name (e.g. { app = sg-... }). The only ingress path; no CIDR ingress exists. A map, not a list, so for_each keys are known at plan time even when the IDs are not."
  type        = map(string)

  validation {
    condition     = length(var.allowed_security_groups) > 0
    error_message = "allowed_security_groups must name at least one security group."
  }
}

variable "engine_version" {
  description = "PostgreSQL version: major only (e.g. \"17\") lets RDS apply minor upgrades in the maintenance window."
  type        = string
  default     = "17"

  validation {
    condition     = can(regex("^(16|17)(\\.[0-9]+)?$", var.engine_version))
    error_message = "engine_version must be PostgreSQL 16 or 17, e.g. \"17\" or \"17.6\"."
  }
}

variable "instance_class" {
  description = "RDS instance class."
  type        = string

  validation {
    condition     = startswith(var.instance_class, "db.")
    error_message = "instance_class must be an RDS class such as db.t4g.micro or db.m7g.large."
  }
}

variable "allocated_storage" {
  description = "Initial gp3 storage in GiB."
  type        = number
  default     = 20

  validation {
    condition     = var.allocated_storage >= 20
    error_message = "gp3 storage for PostgreSQL starts at 20 GiB."
  }
}

variable "max_allocated_storage" {
  description = "Storage autoscaling ceiling in GiB. Must be above allocated_storage."
  type        = number
  default     = 100
}

variable "multi_az" {
  description = "Synchronous standby in a second AZ with automatic failover. Must be true in prod."
  type        = bool
  default     = true
}

variable "backup_retention_days" {
  description = "Automated backup (PITR) retention."
  type        = number
  default     = 7

  validation {
    condition     = var.backup_retention_days >= 7 && var.backup_retention_days <= 35
    error_message = "backup_retention_days must be 7-35: at least a week of point-in-time recovery."
  }
}

variable "deletion_protection" {
  description = "Block deletion through the API. Must be true in prod."
  type        = bool
  default     = true
}

variable "database_name" {
  description = "Initial database created on the instance."
  type        = string
  default     = "bookings"
}

variable "master_username" {
  description = "Master user name. The password is generated by RDS and kept in Secrets Manager, never in Terraform."
  type        = string
  default     = "bookings_admin"

  validation {
    condition     = can(regex("^[a-z][a-z0-9_]{0,62}$", var.master_username)) && !contains(["postgres", "admin", "rdsadmin"], var.master_username)
    error_message = "master_username must be a lowercase identifier and not a reserved name (postgres, admin, rdsadmin)."
  }
}

variable "backup_window" {
  description = "Daily backup window, UTC. Default 18:30-19:30 UTC = 00:00-01:00 IST."
  type        = string
  default     = "18:30-19:30"
}

variable "maintenance_window" {
  description = "Weekly maintenance window, UTC. Default Sun 20:00-21:00 UTC = Mon 01:30-02:30 IST. Must not overlap backups."
  type        = string
  default     = "sun:20:00-sun:21:00"
}

variable "monitoring_interval" {
  description = "Enhanced Monitoring granularity in seconds (0 disables)."
  type        = number
  default     = 60

  validation {
    condition     = contains([0, 1, 5, 10, 15, 30, 60], var.monitoring_interval)
    error_message = "monitoring_interval must be one of 0, 1, 5, 10, 15, 30, 60."
  }
}

variable "log_retention_days" {
  description = "CloudWatch retention for exported PostgreSQL logs."
  type        = number
  default     = 365

  validation {
    condition     = contains([1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653], var.log_retention_days)
    error_message = "log_retention_days must be a value CloudWatch Logs accepts (e.g. 30, 90, 365)."
  }
}

variable "tags" {
  description = "Extra tags for every resource."
  type        = map(string)
  default     = {}
}
