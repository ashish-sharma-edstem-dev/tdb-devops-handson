# Example environment for local runs. Never commit a real .env.
# Nothing loads .env automatically (app/config.py sets env_file=None; settings come from the process environment).
# Export it yourself:
#   cp .env.example .env
#   set -a; . ./.env; set +a; make run
# or pass it to a container:
#   docker run --rm --env-file .env -p 8080:8080 tdb-bookings:local
APP_ENV=local
PORT=8080
LOG_LEVEL=info
# Optional. The service serves sample data and does not need a database; compose.yaml has no postgres.
# In Kubernetes this comes from a Secret; in AWS from Secrets Manager.
# DATABASE_URL=postgresql://bookings:bookings@localhost:5432/bookings
